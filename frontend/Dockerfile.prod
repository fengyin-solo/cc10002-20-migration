# 构建阶段：按 .env.production 的 VITE_BASE_PATH 产出子路径形态产物
FROM node:22-alpine AS build
WORKDIR /srv/web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# 运行阶段：nginx 托管静态资源并把 /api 反代到后端
FROM nginx:1.27-alpine
# nginx 官方镜像启动时用环境变量渲染模板（envsubst），后端地址不写死在镜像里
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /srv/web/dist /srv/metric-insight-web/current
# 单版本镜像：资源池直接指向当前版本的 assets，与多版本部署共用同一份 nginx 配置
RUN ln -s /srv/metric-insight-web/current/assets /srv/metric-insight-web/assets-pool
ENV API_UPSTREAM=backend:8000
EXPOSE 80
